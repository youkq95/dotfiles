#!/bin/bash
# chezmoi: run_once
# 安装 gh (GitHub CLI) — 支持 Linux / Windows

set -euo pipefail

{{ if eq .chezmoi.os "windows" -}}
# ═══════════════════════════════════════
# Windows 安装
# ═══════════════════════════════════════

$binDir = "$env:USERPROFILE\bin"
if (-not (Test-Path $binDir)) { New-Item -ItemType Directory -Path $binDir -Force | Out-Null }
$ghBin = "$binDir\gh.exe"

function Install-GH {
    Write-Host "  [..] 正在安装 gh..." -ForegroundColor Yellow
    $arch = if ([Environment]::Is64BitOperatingSystem) { "amd64" } else { "386" }
    try {
        $release = Invoke-RestMethod -Uri "https://api.github.com/repos/cli/cli/releases/latest" -UseBasicParsing
        $tag = $release.tag_name; $version = $tag.TrimStart('v')
    } catch { Write-Host "  [!!] 获取版本失败: $_" -ForegroundColor Red; return }

    $zipName = "gh_${version}_windows_${arch}.zip"
    $url = "https://github.com/cli/cli/releases/download/${tag}/${zipName}"
    $tmpZip = "$env:TEMP\$zipName"
    Write-Host "  [..] 下载 $url" -ForegroundColor Yellow
    Invoke-WebRequest -Uri $url -OutFile $tmpZip -UseBasicParsing
    $extractDir = "$env:TEMP\gh_${version}_windows_${arch}"
    Expand-Archive -Path $tmpZip -DestinationPath $extractDir -Force
    Copy-Item "$extractDir\bin\gh.exe" $ghBin -Force
    Remove-Item $tmpZip -Force; Remove-Item $extractDir -Recurse -Force
    Write-Host "  [OK] gh $version 已安装" -ForegroundColor Green
}

if (-not (Test-Path $ghBin)) { Install-GH }
else {
    $v = & $ghBin version 2>$null
    if ($v -match '(\d+\.\d+\.\d+)') {
        Write-Host "  [OK] gh $($Matches[1]) 已安装" -ForegroundColor Green
    } else { Install-GH }
}

{{ else -}}
# ═══════════════════════════════════════
# Linux 安装
# ═══════════════════════════════════════

GH_BIN="{{ .chezmoi.homeDir }}/.local/bin/gh"

install_gh() {
    case "$(uname -m)" in
        x86_64)  arch="amd64" ;;
        aarch64) arch="arm64" ;;
        *)       echo "  [!!] 不支持的架构"; exit 1 ;;
    esac
    local tag
    tag=$(curl -sL "https://api.github.com/repos/cli/cli/releases/latest" | grep -oP '"tag_name": "\K[^"]+') || { echo "  [!!] 获取版本失败"; exit 1; }
    local version="${tag#v}"
    local tmpdir; tmpdir=$(mktemp -d)
    local tarball="gh_${version}_linux_${arch}.tar.gz"
    echo "  [..] 下载 gh $version"
    curl -sL "https://github.com/cli/cli/releases/download/${tag}/${tarball}" -o "$tmpdir/gh.tar.gz"
    tar xzf "$tmpdir/gh.tar.gz" -C "$tmpdir"
    cp "$tmpdir/gh_${version}_linux_${arch}/bin/gh" "$GH_BIN"
    chmod +x "$GH_BIN"
    rm -rf "$tmpdir"
    echo "  [OK] gh $version 已安装到 $GH_BIN"
}

mkdir -p "$(dirname "$GH_BIN")"
if [ ! -f "$GH_BIN" ]; then
    install_gh
else
    echo "  [OK] gh 已安装 ($("$GH_BIN" version 2>/dev/null | head -1))"
fi

{{ end -}}
