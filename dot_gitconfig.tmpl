[user]
	name = youkq95
	email = youkq@foxmail.com

[init]
	defaultBranch = main

[core]
{{ if eq .chezmoi.os "windows" -}}
	autocrlf = true
	editor = code --wait
{{ else -}}
	autocrlf = input
{{ end -}}
	excludesfile = {{ .chezmoi.homeDir | quote }}/.config/git/ignore

{{ if eq .chezmoi.os "linux" -}}
[pager]
	diff = delta
{{ end -}}

# Using HTTPS with gh credential helper
[credential]
	helper = !gh auth git-credential

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	cia = commit --amend
	lg = log --graph --oneline --all --decorate
	df = diff
	dc = diff --cached
	undo = reset --soft HEAD~1
	pushf = push --force-with-lease

{{ if .proxy_enabled | default false -}}
# Proxy settings (校园网)
[http]
	proxy = http://202.112.180.24:10808
[https]
	proxy = http://202.112.180.24:10808
{{ end -}}
