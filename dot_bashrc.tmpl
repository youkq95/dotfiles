# ============================================================
# .bashrc — chezmoi managed (dot_bashrc.tmpl)
# Platform: {{ .chezmoi.os }}
# Hostname: {{ .chezmoi.hostname }}
# ============================================================

# ─── PATH ───
{{ if eq .chezmoi.os "windows" -}}
# Windows: 添加 chezmoi 和常用工具到 PATH
export PATH="$HOME/bin:$HOME/scoop/shims:/c/Program Files/nodejs:$PATH"
{{ else -}}
# Linux: 标准路径
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
{{ end -}}

# ─── Editor ───
{{ if eq .chezmoi.os "windows" -}}
export EDITOR="code --wait"
export VISUAL="code --wait"
{{ else -}}
export EDITOR="hx"
export VISUAL="hx"
{{ end -}}

# ─── Prompt ───
{{ if eq .chezmoi.hostname "DESKTOP-KNUNJ5V" -}}
# 家里 Windows PC
export PS1='\[\033[01;32m\]\u@home\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
{{ else if eq .chezmoi.hostname "server-prod" -}}
# 生产服务器 — 红色提示
export PS1='\[\033[01;31m\]\u@PROD\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
{{ else -}}
# 通用 Linux prompt
export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
{{ end -}}

# ─── ls 别名 ───
{{ if eq .chezmoi.os "windows" -}}
alias ls='ls --color=auto --show-control-chars -F'
{{ else -}}
alias ls='ls --color=auto -F'
{{ end -}}
alias ll='ls -lah'
alias la='ls -A'
alias lt='ls -lart'

# ─── 通用别名 ───
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'

# ─── chezmoi ───
alias dotfiles='chezmoi'
alias dot-edit='chezmoi edit'
alias dot-update='chezmoi update'

# ─── 杂项 ───
# 防止覆盖文件
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# 快捷进入常用目录
{{ if eq .chezmoi.hostname "DESKTOP-KNUNJ5V" -}}
alias desk='cd ~/Desktop'
alias down='cd ~/Downloads'
alias doc='cd ~/Documents'
alias proj='cd ~/projects 2>/dev/null || mkdir -p ~/projects && cd ~/projects'
{{ end -}}

# ─── 历史记录 ───
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoreboth:erasedups

# ─── 语言 ───
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ─── Node.js ───
{{ if eq .chezmoi.os "windows" -}}
# 如果使用 fnm/nvm
if [ -f "$HOME/.fnm/fnm.sh" ]; then
    source "$HOME/.fnm/fnm.sh"
fi
{{ end -}}

# ─── chezmoi completion ───
if command -v chezmoi &>/dev/null; then
    source <(chezmoi completion bash 2>/dev/null) || true
fi

# ─── 今日记录 ───
alias today='hx ~/brain/today.md'

k() {
  printf "\n- %s: %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> ~/brain/log.md
}

{{ if and (eq .chezmoi.os "linux") (or (eq .chezmoi.hostname "ps") (eq .chezmoi.hostname "gpu-public") (eq .chezmoi.hostname "lab24") (eq .chezmoi.hostname "lab148")) -}}
# ─── 代理设置 ───
proxy_on() {
    local proxy_host="202.112.180.24"
    local http_port="10808"
    local socks_port="10808"

    export http_proxy="http://${proxy_host}:${http_port}"
    export https_proxy="http://${proxy_host}:${http_port}"
    export all_proxy="socks5://${proxy_host}:${socks_port}"

    export HTTP_PROXY="${http_proxy}"
    export HTTPS_PROXY="${https_proxy}"
    export ALL_PROXY="${all_proxy}"

    echo "✅ 代理已开启 (HTTP Proxy: ${http_proxy})"
}

proxy_off() {
    unset http_proxy
    unset https_proxy
    unset all_proxy

    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset ALL_PROXY

    echo "❌ 代理已关闭"
}

proxy_status() {
    if [ -n "$http_proxy" ]; then
        echo "当前代理状态: 开启"
        echo "-------------------------"
        echo "http_proxy:   $http_proxy"
        echo "https_proxy:  $https_proxy"
        echo "all_proxy:    $all_proxy"
        echo "-------------------------"
    else
        echo "当前代理状态: 关闭"
    fi
}
{{ end -}}
