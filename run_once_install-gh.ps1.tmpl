# PowerShell script - chezmoi: run_once
# 安装/更新 gh (GitHub CLI) — Windows

$ghBin = "$env:USERPROFILE\bin\gh.exe"
$minVersion = "2.50.0"

function Install-GH {
    Write-Host "  [..] 正在安装 gh..." -ForegroundColor Yellow

    # 检测架构
    $arch = "amd64"
    if ([Environment]::Is64BitOperatingSystem -eq $false) {
        $arch = "386"
    }

    # 获取最新版本
    try {
        $latest = Invoke-RestMethod -Uri "https://api.github.com/repos/cli/cli/releases/latest" -UseBasicParsing
        $tag = $latest.tag_name
        $version = $tag.TrimStart('v')
        Write-Host "  [..] 最新版本: $version" -ForegroundColor Yellow
    } catch {
        Write-Host "  [!!] 获取最新版本失败: $_" -ForegroundColor Red
        return
    }

    # 下载
    $tmpDir = [System.IO.Path]::GetTempPath()
    $zipName = "gh_${version}_windows_${arch}.zip"
    $downloadUrl = "https://github.com/cli/cli/releases/download/${tag}/${zipName}"
    $zipPath = Join-Path $tmpDir $zipName

    Write-Host "  [..] 下载 $downloadUrl" -ForegroundColor Yellow
    Invoke-WebRequest -Uri $downloadUrl -OutFile $zipPath -UseBasicParsing

    # 解压
    $extractDir = Join-Path $tmpDir "gh_${version}_windows_${arch}"
    Expand-Archive -Path $zipPath -DestinationPath $extractDir -Force

    # 复制 gh.exe 到 bin 目录
    $binDir = [System.IO.Path]::GetDirectoryName($ghBin)
    if (-not (Test-Path $binDir)) {
        New-Item -ItemType Directory -Path $binDir -Force | Out-Null
    }
    Copy-Item "$extractDir\bin\gh.exe" $ghBin -Force

    # 清理
    Remove-Item $zipPath -Force
    Remove-Item $extractDir -Recurse -Force

    Write-Host "  [OK] gh $version 已安装到 $ghBin" -ForegroundColor Green
}

# ─── 主逻辑 ───
$binDir = [System.IO.Path]::GetDirectoryName($ghBin)
if (-not (Test-Path $binDir)) {
    New-Item -ItemType Directory -Path $binDir -Force | Out-Null
}

if (-not (Test-Path $ghBin)) {
    Install-GH
} else {
    $installedVer = & $ghBin version 2>$null
    if ($installedVer -match 'version (\d+\.\d+\.\d+)') {
        $ver = $Matches[1]
        Write-Host "  [..] 当前版本: gh $ver" -ForegroundColor Yellow

        if ($ver -ge $minVersion) {
            Write-Host "  [OK] gh 已是最新 ($ver)" -ForegroundColor Green
        } else {
            Write-Host "  [..] gh $ver 需要更新..." -ForegroundColor Yellow
            Install-GH
        }
    } else {
        Install-GH
    }
}

# 检查 PATH
if (-not (Get-Command gh -ErrorAction SilentlyContinue)) {
    Write-Host "  [!] 请将 $binDir 添加到 PATH 环境变量" -ForegroundColor Yellow
    Write-Host "      或重新打开终端" -ForegroundColor Yellow
}
