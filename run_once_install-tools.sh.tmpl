#!/bin/bash
# chezmoi: run_once
# 安装常用工具 (helix, fzf) — 无需 sudo

set -euo pipefail

BIN_DIR="{{ .chezmoi.homeDir }}/.local/bin"
mkdir -p "$BIN_DIR"

# 检测架构
case "$(uname -m)" in
    x86_64)  arch="x86_64" ;;
    aarch64) arch="aarch64" ;;
    *)       echo "  [!!] 不支持的架构: $(uname -m)"; exit 1 ;;
esac

# ──────────────────────────────────────
# helix (hx)
# ──────────────────────────────────────
install_helix() {
    local current="$1"

    echo "  [..] 获取 helix 最新版本..."
    local tag
    tag=$(curl -sL "https://api.github.com/repos/helix-editor/helix/releases/latest" | grep -oP '"tag_name": "\K[^"]+') || {
        echo "  [!!] 获取 helix 版本失败"; return 1
    }
    local version="${tag#v}"
    echo "  [..] 最新版本: $version (当前: $current)"

    if [ "$current" = "$version" ]; then
        echo "  [OK] helix 已是最新"
        return 0
    fi

    local tmpdir
    tmpdir=$(mktemp -d)
    local tarball="helix-${version}-${arch}-linux.tar.xz"
    local url="https://github.com/helix-editor/helix/releases/download/${tag}/${tarball}"

    echo "  [..] 下载 $url"
    curl -sL "$url" -o "$tmpdir/helix.tar.xz"

    tar xf "$tmpdir/helix.tar.xz" -C "$tmpdir"
    cp "$tmpdir/helix-${version}-${arch}-linux/hx" "$BIN_DIR/hx"
    chmod +x "$BIN_DIR/hx"

    # 复制 runtime（语法高亮等）
    local runtime_dir="{{ .chezmoi.homeDir }}/.config/helix/runtime"
    mkdir -p "$(dirname "$runtime_dir")"
    if [ -d "$tmpdir/helix-${version}-${arch}-linux/runtime" ]; then
        rm -rf "$runtime_dir"
        cp -r "$tmpdir/helix-${version}-${arch}-linux/runtime" "$runtime_dir"
        echo "  [..] helix runtime 已安装到 $runtime_dir"
    fi

    rm -rf "$tmpdir"
    echo "  [OK] helix $version 已安装"
}

# ──────────────────────────────────────
# fzf
# ──────────────────────────────────────
install_fzf() {
    local current="$1"

    echo "  [..] 获取 fzf 最新版本..."
    local tag
    tag=$(curl -sL "https://api.github.com/repos/junegunn/fzf/releases/latest" | grep -oP '"tag_name": "\K[^"]+') || {
        echo "  [!!] 获取 fzf 版本失败"; return 1
    }
    local version="${tag#v}"
    echo "  [..] 最新版本: $version (当前: $current)"

    if [ "$current" = "$version" ]; then
        echo "  [OK] fzf 已是最新"
        return 0
    fi

    local tmpdir
    tmpdir=$(mktemp -d)
    local tarball="fzf-${version}-linux_${arch}.tar.gz"
    local url="https://github.com/junegunn/fzf/releases/download/${tag}/${tarball}"

    echo "  [..] 下载 $url"
    curl -sL "$url" -o "$tmpdir/fzf.tar.gz"

    tar xzf "$tmpdir/fzf.tar.gz" -C "$tmpdir"
    cp "$tmpdir/fzf" "$BIN_DIR/fzf"
    chmod +x "$BIN_DIR/fzf"

    rm -rf "$tmpdir"
    echo "  [OK] fzf $version 已安装"
}

# ──────────────────────────────────────
# 主逻辑
# ──────────────────────────────────────
echo ""
echo "  ╔══════════════════════════════╗"
echo "  ║   安装常用工具 (Linux)        ║"
echo "  ╚══════════════════════════════╝"
echo ""

# ── helix ──
echo "  ── helix ──"
CUR_HX=""
if command -v hx &>/dev/null; then
    CUR_HX=$(hx --version 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' || echo "")
fi
if [ -z "$CUR_HX" ]; then
    echo "  [..] helix 未安装，正在安装..."
    install_helix ""
else
    echo "  [..] 当前: hx $CUR_HX"
    install_helix "$CUR_HX"
fi
echo ""

# ── fzf ──
echo "  ── fzf ──"
CUR_FZF=""
if command -v fzf &>/dev/null; then
    CUR_FZF=$(fzf --version 2>/dev/null | awk '{print $1}' || echo "")
fi
if [ -z "$CUR_FZF" ]; then
    echo "  [..] fzf 未安装，正在安装..."
    install_fzf ""
else
    echo "  [..] 当前: fzf $CUR_FZF"
    install_fzf "$CUR_FZF"
fi
echo ""

echo "  [OK] 工具安装完成"
