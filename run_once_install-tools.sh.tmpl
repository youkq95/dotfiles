#!/bin/bash
# chezmoi: run_once
# 安装常用工具 (helix, fzf) — 支持 Linux / Windows

set -euo pipefail

{{ if eq .chezmoi.os "windows" -}}
# ═══════════════════════════════════════
# Windows 安装
# ═══════════════════════════════════════

$binDir = "$env:USERPROFILE\bin"
if (-not (Test-Path $binDir)) { New-Item -ItemType Directory -Path $binDir -Force | Out-Null }

function Get-Version($repo) {
    try { $r = Invoke-RestMethod -Uri "https://api.github.com/repos/$repo/releases/latest" -UseBasicParsing; return $r.tag_name.TrimStart('v') } catch { return $null }
}

# ── helix ──
$hxVer = Get-Version "helix-editor/helix"
if ($hxVer) {
    $hxBin = "$binDir\hx.exe"
    if (-not (Test-Path $hxBin)) {
        Write-Host "  [..] 安装 helix $hxVer ..." -ForegroundColor Yellow
        $url = "https://github.com/helix-editor/helix/releases/download/v${hxVer}/helix-${hxVer}-x86_64-windows.zip"
        $tmp = "$env:TEMP\helix.zip"; Invoke-WebRequest -Uri $url -OutFile $tmp -UseBasicParsing
        $d = "$env:TEMP\helix"; Expand-Archive -Path $tmp -DestinationPath $d -Force
        Copy-Item "$d\hx.exe" $hxBin -Force
        Remove-Item $tmp -Force; Remove-Item $d -Recurse -Force
        Write-Host "  [OK] helix $hxVer 已安装" -ForegroundColor Green
    } else { Write-Host "  [OK] helix 已安装" -ForegroundColor Green }
}

# ── fzf ──
$fzfVer = Get-Version "junegunn/fzf"
if ($fzfVer) {
    $fzfBin = "$binDir\fzf.exe"
    if (-not (Test-Path $fzfBin)) {
        Write-Host "  [..] 安装 fzf $fzfVer ..." -ForegroundColor Yellow
        $url = "https://github.com/junegunn/fzf/releases/download/v${fzfVer}/fzf-${fzfVer}-windows_amd64.zip"
        $tmp = "$env:TEMP\fzf.zip"; Invoke-WebRequest -Uri $url -OutFile $tmp -UseBasicParsing
        $d = "$env:TEMP\fzf"; Expand-Archive -Path $tmp -DestinationPath $d -Force
        Copy-Item "$d\fzf.exe" $fzfBin -Force
        Remove-Item $tmp -Force; Remove-Item $d -Recurse -Force
        Write-Host "  [OK] fzf $fzfVer 已安装" -ForegroundColor Green
    } else { Write-Host "  [OK] fzf 已安装" -ForegroundColor Green }
}

{{ else -}}
# ═══════════════════════════════════════
# Linux 安装
# ═══════════════════════════════════════

BIN_DIR="{{ .chezmoi.homeDir }}/.local/bin"
mkdir -p "$BIN_DIR"

case "$(uname -m)" in
    x86_64)  arch="x86_64" ;;
    aarch64) arch="aarch64" ;;
    *)       echo "  [!!] 不支持的架构"; exit 1 ;;
esac

# ── helix ──
install_helix() {
    local tag; tag=$(curl -sL "https://api.github.com/repos/helix-editor/helix/releases/latest" | grep -oP '"tag_name": "\K[^"]+') || return 1
    local version="${tag#v}"
    local tmpdir; tmpdir=$(mktemp -d)
    local tarball="helix-${version}-${arch}-linux.tar.xz"
    echo "  [..] 下载 helix $version"
    curl -sL "https://github.com/helix-editor/helix/releases/download/${tag}/${tarball}" -o "$tmpdir/helix.tar.xz"
    tar xf "$tmpdir/helix.tar.xz" -C "$tmpdir"
    cp "$tmpdir/helix-${version}-${arch}-linux/hx" "$BIN_DIR/hx"
    chmod +x "$BIN_DIR/hx"
    local runtime="{{ .chezmoi.homeDir }}/.config/helix/runtime"
    if [ -d "$tmpdir/helix-${version}-${arch}-linux/runtime" ]; then
        rm -rf "$runtime"; cp -r "$tmpdir/helix-${version}-${arch}-linux/runtime" "$(dirname "$runtime")/"
    fi
    rm -rf "$tmpdir"
    echo "  [OK] helix $version 已安装"
}

if ! command -v hx &>/dev/null; then
    install_helix
else
    echo "  [OK] hx 已安装 ($(hx --version 2>/dev/null | head -1))"
fi

# ── fzf (使用 amd64/arm64 架构名) ──
install_fzf() {
    local tag; tag=$(curl -sL "https://api.github.com/repos/junegunn/fzf/releases/latest" | grep -oP '"tag_name": "\K[^"]+') || return 1
    local version="${tag#v}"
    local fzf_arch
    case "$(uname -m)" in
        x86_64)  fzf_arch="amd64" ;;
        aarch64) fzf_arch="arm64" ;;
        *)       echo "  [!!] 不支持的架构"; return 1 ;;
    esac
    local tmpdir; tmpdir=$(mktemp -d)
    echo "  [..] 下载 fzf $version"
    curl -sL "https://github.com/junegunn/fzf/releases/download/${tag}/fzf-${version}-linux_${fzf_arch}.tar.gz" -o "$tmpdir/fzf.tar.gz"
    tar xzf "$tmpdir/fzf.tar.gz" -C "$tmpdir"
    cp "$tmpdir/fzf" "$BIN_DIR/fzf"
    chmod +x "$BIN_DIR/fzf"
    rm -rf "$tmpdir"
    echo "  [OK] fzf $version 已安装"
}

if ! command -v fzf &>/dev/null; then
    install_fzf
else
    echo "  [OK] fzf 已安装 ($(fzf --version 2>/dev/null | awk '{print $1}'))"
fi

{{ end -}}
