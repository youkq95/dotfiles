#!/bin/bash
# chezmoi: run_once
# 安装常用终端工具 (Linux/macOS)

{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}

set -euo pipefail

echo "🔧 检查并安装工具 ({{ .chezmoi.os }})..."

# ─── Starship ───
if ! command -v starship &>/dev/null; then
    echo "  -> 安装 Starship..."
    curl -fsSL --proto '=https' --tlsv1.2 https://starship.rs/install.sh | sh /dev/stdin --yes -b ~/.local/bin
    echo "  ✅ Starship 安装完成"
else
    echo "  ✅ Starship 已安装 ($(starship --version))"
fi

# ─── zoxide ───
if ! command -v zoxide &>/dev/null; then
    echo "  -> 安装 zoxide..."
    curl -fsSL --proto '=https' --tlsv1.2 https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
    echo "  ✅ zoxide 安装完成"
else
    echo "  ✅ zoxide 已安装 ($(zoxide --version))"
fi

echo "🎉 所有工具检查完毕!"

{{ else -}}
echo "⏭️  跳过工具安装 (非 Unix 平台: {{ .chezmoi.os }})"
{{ end -}}
