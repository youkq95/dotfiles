# chezmoi 全局配置
[git]
    autoCommit = false
    autoPush = false

[keep]
    dirs = [".chezmoi", ".git"]

# 按机器自定义数据
[data]
    # 首次初始化时询问；值保存在本机配置，不进入 Git
    claude_api_token = {{ promptStringOnce . "claude_api_token" "Claude API token (可留空)" | quote }}
    deepseek_api_key = {{ promptStringOnce . "deepseek_api_key" "DeepSeek API key (可留空)" | quote }}
    stepfun_api_key = {{ promptStringOnce . "stepfun_api_key" "StepFun API key (可留空)" | quote }}
    # 校园网内机器才需要代理
    proxy_enabled = {{ if or (eq .chezmoi.hostname "lab24") (eq .chezmoi.hostname "lab148") (eq .chezmoi.hostname "gpu-public") (eq .chezmoi.hostname "ps") }}true{{ else }}false{{ end }}

{{ if eq .chezmoi.os "windows" -}}
# Windows 用 VS Code 编辑
[edit]
    command = "code"
    args = ["--wait"]

# Windows 上用 bash 执行 .sh 脚本
[interpreters]
    [interpreters.sh]
    command = "bash"
{{ else -}}
{{ end -}}
