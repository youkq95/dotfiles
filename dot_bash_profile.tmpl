{{ if ne .chezmoi.os "windows" -}}
# ─── bash_profile: loaded by login shells ───
# Chain-load bashrc (interactive config) and profile (session config)

# Keep common user tools available to non-interactive login shells too.
case ":$PATH:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

[ -f ~/.bashrc ] && . ~/.bashrc
[ -f ~/.profile ] && . ~/.profile
{{ end -}}
