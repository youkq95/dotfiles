#!/bin/bash
# chezmoi: run_once
# 安装/更新 pi coding agent

{{ if eq .chezmoi.os "windows" -}}
# Windows — 需要 Node.js
$piBin = "$env:USERPROFILE\AppData\Roaming\npm\pi.cmd"
if (Get-Command node -ErrorAction SilentlyContinue) {
    $current = $null
    if (Test-Path $piBin) { $current = & $piBin --version 2>$null }
    $tag = "latest"
    Write-Host "  [..] 安装 pi coding agent..." -ForegroundColor Yellow
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent@$tag 2>&1 | Out-Null
    $newVer = & pi --version 2>$null
    Write-Host "  [OK] pi $newVer 已安装" -ForegroundColor Green
} else {
    Write-Host "  [!!] 需要先安装 Node.js: https://nodejs.org" -ForegroundColor Red
}
{{ else -}}
# Linux — 使用官方安装脚本
PI_BIN="{{ .chezmoi.homeDir }}/.local/bin/pi"

CURRENT=""
if command -v pi &>/dev/null; then
    CURRENT=$(pi --version 2>/dev/null || echo "")
fi

echo "  [..] 当前: pi ${CURRENT:-未安装}"

if [ -z "$CURRENT" ]; then
    echo "  [..] 正在安装 pi (官方脚本)..."
    curl -fsSL https://pi.dev/install.sh | sh 2>&1 | tail -3
else
    echo "  [..] pi 已安装，跳过"
fi

NEW_VER="$(pi --version 2>/dev/null || echo '?')"
echo "  [OK] pi $NEW_VER"

# ─── 初始化 pi-config ───
PI_CONFIG_DIR="{{ .chezmoi.homeDir }}/pi-config"
if [ ! -d "$PI_CONFIG_DIR" ]; then
    echo "  [..] 克隆 pi-config 仓库..."
    if command -v gh &>/dev/null && gh auth status 2>/dev/null >&2; then
        gh repo clone youkq95/pi-config "$PI_CONFIG_DIR" 2>&1 | tail -1
        echo "  [OK] pi-config 已克隆到 $PI_CONFIG_DIR"
    else
        echo "  [..] gh 未登录，跳过克隆 pi-config"
        echo "      之后可手动: gh repo clone youkq95/pi-config ~/pi-config"
    fi
fi
{{ end -}}
