# 所有机器都忽略
README.md
LICENSE

# Windows 忽略 Linux 专用文件
{{ if eq .chezmoi.os "windows" -}}
.tmux.conf
.Xresources
.xinitrc
.config/i3/
.config/sway/
.config/waybar/
run_once_before_setup.sh*
run_assemble-authorized-keys.sh*
run_fix-ssh-perms.sh*
{{ end -}}

# macOS 忽略 Linux 桌面专用文件，但保留通用 shell 脚本
{{ if eq .chezmoi.os "darwin" -}}
.Xresources
.xinitrc
.config/i3/
.config/sway/
.config/waybar/
# This Mac is an SSH client; keep server-side authorized_keys out of it.
.ssh/authorized_keys.d/
assemble-authorized-keys.sh*
{{ end -}}

# Unix 系统忽略 Windows 专用文件
{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
Microsoft.PowerShell_profile.ps1
.config/WindowsTerminal/
run_once_before_setup.ps1*
setup.ps1*
{{ end -}}
