# PowerShell script - chezmoi: run_once
# 安装常用工具 (helix, fzf) — Windows

$binDir = "$env:USERPROFILE\bin"
if (-not (Test-Path $binDir)) { New-Item -ItemType Directory -Path $binDir -Force | Out-Null }

function Get-LatestVersion {
    param($repo)
    try {
        $release = Invoke-RestMethod -Uri "https://api.github.com/repos/$repo/releases/latest" -UseBasicParsing
        return $release.tag_name.TrimStart('v')
    } catch {
        return $null
    }
}

function Install-Helix {
    $current = "未安装"
    if (Get-Command hx -ErrorAction SilentlyContinue) {
        $ver = & hx --version 2>$null
        if ($ver -match '(\d+\.\d+\.\d+)') { $current = $Matches[1] }
    }
    Write-Host "  [..] helix: $current" -ForegroundColor Yellow

    $version = Get-LatestVersion "helix-editor/helix"
    if (-not $version) { Write-Host "  [!!] 获取版本失败" -ForegroundColor Red; return }
    Write-Host "  [..] 最新: $version" -ForegroundColor Yellow

    if ($current -eq $version) { Write-Host "  [OK] helix 已最新"; return }

    $zipName = "helix-${version}-x86_64-windows.zip"
    $url = "https://github.com/helix-editor/helix/releases/download/v${version}/${zipName}"
    $tmpZip = "$env:TEMP\$zipName"

    Write-Host "  [..] 下载 $url" -ForegroundColor Yellow
    Invoke-WebRequest -Uri $url -OutFile $tmpZip -UseBasicParsing

    $extractDir = "$env:TEMP\helix-${version}-x86_64-windows"
    Expand-Archive -Path $tmpZip -DestinationPath $extractDir -Force

    Copy-Item "$extractDir\hx.exe" "$binDir\hx.exe" -Force
    Remove-Item $tmpZip -Force
    Remove-Item $extractDir -Recurse -Force
    Write-Host "  [OK] helix $version 已安装" -ForegroundColor Green
}

function Install-Fzf {
    $current = "未安装"
    if (Get-Command fzf -ErrorAction SilentlyContinue) {
        $ver = & fzf --version 2>$null
        if ($ver -match '(\d+\.\d+\.\d+)') { $current = $Matches[1] }
    }
    Write-Host "  [..] fzf: $current" -ForegroundColor Yellow

    $version = Get-LatestVersion "junegunn/fzf"
    if (-not $version) { Write-Host "  [!!] 获取版本失败" -ForegroundColor Red; return }
    Write-Host "  [..] 最新: $version" -ForegroundColor Yellow

    if ($current -eq $version) { Write-Host "  [OK] fzf 已最新"; return }

    $zipName = "fzf-${version}-windows_amd64.zip"
    $url = "https://github.com/junegunn/fzf/releases/download/v${version}/${zipName}"
    $tmpZip = "$env:TEMP\$zipName"

    Write-Host "  [..] 下载 $url" -ForegroundColor Yellow
    Invoke-WebRequest -Uri $url -OutFile $tmpZip -UseBasicParsing

    $tmpDir = "$env:TEMP\fzf-${version}"
    Expand-Archive -Path $tmpZip -DestinationPath $tmpDir -Force

    Copy-Item "$tmpDir\fzf.exe" "$binDir\fzf.exe" -Force
    Remove-Item $tmpZip -Force
    Remove-Item $tmpDir -Recurse -Force
    Write-Host "  [OK] fzf $version 已安装" -ForegroundColor Green
}

Write-Host ""
Write-Host "  ╔══════════════════════════════╗"
Write-Host "  ║   安装常用工具 (Windows)      ║"
Write-Host "  ╚══════════════════════════════╝"
Write-Host ""

Write-Host "  ── helix ──"
Install-Helix
Write-Host ""

Write-Host "  ── fzf ──"
Install-Fzf
Write-Host ""

Write-Host "  [OK] 工具安装完成" -ForegroundColor Green
