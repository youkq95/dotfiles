#!/bin/bash
# chezmoi: run
# 从 authorized_keys.d/*.pub 合并生成 authorized_keys (跨平台)

{{ if eq .chezmoi.os "windows" -}}
# ═══════════════════════════════════════
# Windows — 通过 bash 调用 PowerShell
# ═══════════════════════════════════════

powershell -NoLogo -NonInteractive -Command - << 'PSEOF'
$sshDir = "$env:USERPROFILE\.ssh"
$keysDir = "$sshDir\authorized_keys.d"
$authKeys = "$sshDir\authorized_keys"

if (-not (Test-Path $keysDir)) { exit 0 }

$header = @'
# ============================================================
# authorized_keys — auto-generated by chezmoi
# DO NOT EDIT MANUALLY
# 在 ~/.ssh/authorized_keys.d/ 中添加/删除 .pub 文件
# 然后运行 chezmoi apply
# ============================================================

'@

Set-Content -Path $authKeys -Value $header

Get-ChildItem "$keysDir\*.pub" | ForEach-Object {
    Add-Content -Path $authKeys -Value "# Source: $($_.Name)"
    $content = Get-Content -Path $_.FullName -Raw
    Add-Content -Path $authKeys -Value $content.Trim()
    Add-Content -Path $authKeys -Value ""
}

Write-Host "  [OK] Generated $authKeys from $keysDir"
PSEOF
exit $?

{{ else -}}
# ═══════════════════════════════════════
# Linux
# ═══════════════════════════════════════

SSH_DIR="{{ .chezmoi.homeDir }}/.ssh"
KEYS_DIR="$SSH_DIR/authorized_keys.d"
AUTH_KEYS="$SSH_DIR/authorized_keys"

if [ ! -d "$KEYS_DIR" ]; then
    exit 0
fi

cat > "$AUTH_KEYS" << 'HEADER'
# ============================================================
# authorized_keys — auto-generated by chezmoi
# DO NOT EDIT MANUALLY
# 在 ~/.ssh/authorized_keys.d/ 中添加/删除 .pub 文件
# 然后运行 chezmoi apply
# ============================================================

HEADER

for keyfile in "$KEYS_DIR"/*.pub; do
    [ -f "$keyfile" ] || continue
    if [ -s "$keyfile" ]; then
        echo "# Source: $(basename "$keyfile")" >> "$AUTH_KEYS"
        cat "$keyfile" >> "$AUTH_KEYS"
        echo "" >> "$AUTH_KEYS"
    fi
done

chmod 600 "$AUTH_KEYS"
echo "  [OK] Generated $AUTH_KEYS from $KEYS_DIR"

{{ end -}}
