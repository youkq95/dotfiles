# ============================================================
# SSH config — chezmoi managed
# Hostname: {{ .chezmoi.hostname }}
# ============================================================

{{ if eq .chezmoi.hostname "DESKTOP-KNUNJ5V" -}}
# ─── 家里 Windows PC (homepc) ───

# 连接服务器
Host ps
    HostName 222.28.103.242
    Port 22
    User kos
    IdentityFile ~/.ssh/id_rsa

{{ end -}}

# ─── 全局默认配置 ───
Host *
    # 默认使用 id_rsa
    IdentityFile ~/.ssh/id_rsa
    # 保持连接活跃
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # 如果连接断开自动重试
    TCPKeepAlive yes
    # 严格主机密钥检查
    StrictHostKeyChecking ask
